# ============================================
# AI 身材管家 - 环境变量示例
# 复制为 .env 文件并填入实际值
# ============================================

# ---------- DeepSeek API ----------
# 注册：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 飞书开放平台 ----------
# 创建应用：https://open.feishu.cn/app
# 需要权限：bitable:app:readonly, bitable:app:readonly, drive:file
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=your_app_secret
# 多维表格的 app_token（在表格 URL 里：base/XXXXX?table=...）
FEISHU_APP_TOKEN=your_app_token

# ---------- 飞书 5 张表格的 table_id ----------
# 在飞书表格的「设置 → 高级设置 → 字段」URL 里能找到
FEISHU_TABLE_BODY=body_records_table_id
FEISHU_TABLE_WORKOUT=workout_logs_table_id
FEISHU_TABLE_MEAL=meal_logs_table_id
FEISHU_TABLE_CONVERSATION=ai_conversations_table_id
FEISHU_TABLE_PROFILE=user_profile_table_id